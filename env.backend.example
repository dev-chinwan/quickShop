NEXT_PUBLIC_API_MODE=backend
NEXT_PUBLIC_API_BASE_URL=/api

# json | mongodb
DATA_PROVIDER=json

# Required only when DATA_PROVIDER=mongodb
MONGODB_URI=
MONGODB_DB=quickshop

# WhatsApp notification integration (Meta WhatsApp Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_STRICT_MODE=true
WHATSAPP_OWNER_PHONE=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_API_VERSION=v22.0
WHATSAPP_TIMEOUT_MS=10000
